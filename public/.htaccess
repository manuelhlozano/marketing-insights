<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Servir archivos físicos existentes (CSS, JS, PNG, PHP, etc.) sin reescribir
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Servir directorios físicos sin reescribir (excepto raíz)
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # HOME: Redirigir raíz estricta a login.html
    RewriteRule ^$ login.html [L]

    # /login -> login.html (también /login/)
    RewriteRule ^login/?$ login.html [L]

    # /admin -> admin/index.html (sin exponer la ruta del archivo)
    RewriteRule ^admin/?$ admin/index.html [L]

    # /admin/{vista} -> admin/index.html (URL propia por vista: /admin/sorteos,
    # /admin/ruletas...). Debe ir antes de las reglas de {empresa}/{dashboard},
    # que si no se tragarían estas rutas como si fueran de un cliente.
    RewriteRule ^admin/[a-z-]+/?$ admin/index.html [L]

    # /api/* -> PHP handler
    RewriteRule ^api/(.+)$ api/$1 [L]

    # /{empresa}/{dashboard} con token -> index.html
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.html?empresa=$1&dashboard=$2 [QSA,L]

    # /{empresa} solo -> index.html
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.html?empresa=$1 [QSA,L]
</IfModule>

# Cache de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    # Antes había aquí un Access-Control-Allow-Origin "*" global, que abría a
    # cualquier sitio la lectura de TODAS las respuestas, incluidos los
    # informes con token. Los tres endpoints que de verdad lo necesitan
    # (data.php, concursos.php y leads-webhook.php, que los llaman las landings
    # del cliente desde otro dominio) ya envían esa cabecera por su cuenta.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Nada de este dominio es para el público general: los informes, los
    # sorteos y las ruletas se comparten por enlace con token a gente concreta.
    # La cabecera se envía en TODAS las respuestas (también en las de la API y
    # en los enlaces con token) porque robots.txt solo pide que no rastreen:
    # una URL que alguien pegue en un chat o en un correo puede llegar al
    # índice igual. Esta es la instrucción que sí retira la página.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"

    # Un SVG abierto directamente es un documento y puede traer <script>
    # dentro. Esta política solo aplica a archivos .svg (como imagen dentro de
    # un <img> no cambia nada) y deja inertes los que ya estén subidos.
    <FilesMatch "\.svgz?$">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:"
    </FilesMatch>
</IfModule>
