<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Servir archivos físicos existentes (CSS, JS, PNG, PHP, etc.) sin reescribir
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Servir directorios físicos sin reescribir (excepto raíz)
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # HOME: Redirigir raíz estricta a login.html
    RewriteRule ^$ login.html [L]

    # /login -> login.html (también /login/)
    RewriteRule ^login/?$ login.html [L]

    # /admin -> admin/index.html (sin exponer la ruta del archivo)
    RewriteRule ^admin/?$ admin/index.html [L]

    # /api/* -> PHP handler
    RewriteRule ^api/(.+)$ api/$1 [L]

    # /{empresa}/{dashboard} con token -> index.html
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.html?empresa=$1&dashboard=$2 [QSA,L]

    # /{empresa} solo -> index.html
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.html?empresa=$1 [QSA,L]
</IfModule>

# Cache de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
